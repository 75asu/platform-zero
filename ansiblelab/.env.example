# ansiblelab -- connection config. Copy to .env (gitignored) and fill in.
#   cp .env.example .env && vim .env && make connect
#
# TWO WAYS to point at the target machine:
#
#  1) ssh_config alias  (RECOMMENDED -- reuses ~/.ssh/config):
#       TARGET_HOST=homelab
#     Leave TARGET_USER / SSH_KEY_PATH blank. The alias in ~/.ssh/config supplies
#     the hostname, user, key, and any ProxyJump. Cleanest path for the homelab.
#
#  2) explicit  (for a cloud VM or anything not in ssh_config):
#       TARGET_HOST=203.0.113.10
#       TARGET_USER=ubuntu
#       SSH_KEY_PATH=~/.ssh/id_ed25519
#       TARGET_PORT=22           # optional; omit for 22
#       SSH_JUMP=user@bastion    # optional bastion / jump host

TARGET_HOST=
TARGET_USER=
SSH_KEY_PATH=
TARGET_PORT=
SSH_JUMP=

# Optional: sudo password on the target. Leave blank for passwordless sudo.
BECOME_PASS=

# Optional: inventory label for the host (default: ansiblelab).
LAB_HOST_NAME=

# --- GCP VM lifecycle (optional) ---------------------------------------------
# If these are set, `make up / down / ssh / vm-*` manage this GCP VM, and the
# inventory resolves its CURRENT external IP live from gcloud (Spot IPs change on
# every stop/start), so you never hardcode TARGET_HOST. Leave blank for a plain
# SSH host. gcloud auth lives in ~/.config/gcloud -- never in this repo.
GCP_PROJECT=
GCP_ZONE=
GCP_VM_NAME=
